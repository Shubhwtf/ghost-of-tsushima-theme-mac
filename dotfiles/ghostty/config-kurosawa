# 冥人 Ghost of Tsushima, Kurosawa mode — Ghostty
# ~/.config/ghostty/config  (the theme lives in ~/.config/ghostty/themes/ghost-of-tsushima)

theme = ghost-of-tsushima-kurosawa

# type
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 15%

# window
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend
window-theme = dark
window-colorspace = srgb
window-save-state = always
window-width = 120
window-height = 34
background-opacity = 0.95
background-blur = 20
unfocused-split-opacity = 0.85

# macOS
macos-titlebar-style = tabs
macos-option-as-alt = true
macos-window-shadow = true
# Ghostty's icon is a ghost; make it this ghost: paper on an ink screen, in black and white
macos-icon = custom-style
macos-icon-frame = chrome
macos-icon-ghost-color = #e4e4e4
macos-icon-screen-color = #121212,#262626

# cursor
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.95
shell-integration-features = no-cursor,sudo,title

# behaviour
copy-on-select = clipboard
confirm-close-surface = false
mouse-hide-while-typing = true
quit-after-last-window-closed = true

# keys
keybind = cmd+enter=new_split:right
keybind = cmd+shift+enter=new_split:down
keybind = cmd+]=goto_split:next
keybind = cmd+[=goto_split:previous
keybind = cmd+shift+z=toggle_split_zoom
