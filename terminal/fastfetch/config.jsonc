// Ghost of Tsushima — generated from palette.json by src/shell.py
// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/ghost.ansi",
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#e23d43", "title": "#f6f1e7", "output": "#ece6dc", "separator": "#3a3330" },
    "key": { "width": 12 },
    "bar": { "char": { "elapsed": "━", "total": "━" }, "color": { "elapsed": "#c1121f", "total": "#2a2523" } },
    "percent": { "type": ["bar", "num"], "color": { "green": "#9db97c", "yellow": "#c9a45c", "red": "#e23d43" } }
  },
  "modules": [
    { "type": "custom", "format": "{#1;38;2;226;61;67}冥人  {#0;38;2;246;241;231}GHOST OF TSUSHIMA" },
    { "type": "custom", "format": "{#38;2;58;51;48}──────────────────────────────" },
    { "type": "title", "key": "\uf007 user", "format": "{user-name}{#38;2;131;122;115}@{#}{host-name}" },
    { "type": "os", "key": "\uf179 os" },
    { "type": "host", "key": "\uf109 host" },
    { "type": "kernel", "key": "\uf013 kernel" },
    { "type": "uptime", "key": "\uf017 uptime" },
    { "type": "packages", "key": "\uf487 pkgs" },
    { "type": "shell", "key": "\uf120 shell" },
    { "type": "terminal", "key": "\ue795 term" },
    { "type": "terminalfont", "key": "\uf031 font" },
    { "type": "cpu", "key": "\uf2db cpu", "showPeCoreCount": true },
    { "type": "gpu", "key": "\uf26c gpu" },
    { "type": "memory", "key": "\uefc5 memory" },
    { "type": "disk", "key": "\uf0a0 disk", "folders": "/" },
    { "type": "battery", "key": "\uf240 battery" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
